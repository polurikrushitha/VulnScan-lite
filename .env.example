# ==============================================================================
# VulnScan Lite — Root Environment Variables Template
# Copy this file to .env or use backend/.env and frontend/.env as needed.
# NEVER commit real credentials or secret values to version control.
# ==============================================================================

# --- Backend Database ---
# PostgreSQL connection string (e.g. Neon PostgreSQL 15+ or local instance)
# Format: postgresql+psycopg://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vulnscan

# --- Backend Redis Broker & Celery ---
# Redis connection URL for Celery async task queue
REDIS_URL=redis://localhost:6379/0

# --- Backend Authentication & Security ---
# Secret key used for signing JWT tokens (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Backend CORS & Network Policies ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App environment ('development' or 'production')
ENVIRONMENT=development

# Development target testing allowlist (disabled in production)
ALLOW_DEV_TARGETS=false
DEV_TARGET_ALLOWLIST=localhost:3000,localhost:8080,127.0.0.1:3000,127.0.0.1:8080
ALLOW_LOCAL_SCANNING=false

# Rate limits (SlowAPI)
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SCAN=3/minute
RATE_LIMIT_PDF=5/minute

# --- Frontend Settings ---
# In production, set this to your deployed FastAPI backend URL (e.g. https://api.vulnscan.example.com)
# In local development with Vite proxy, leave empty or set to http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:8000
