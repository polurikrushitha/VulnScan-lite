# VulnScan Lite — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# PostgreSQL connection string (Neon or any PostgreSQL 15+ compatible)
# Format: postgresql+psycopg://username:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/vulnscan

# Redis connection string for Celery
REDIS_URL=redis://localhost:6379/0

# JWT configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# App environment & scanning policies
ENVIRONMENT=development
ALLOW_DEV_TARGETS=false
DEV_TARGET_ALLOWLIST=localhost:3000,localhost:8080,127.0.0.1:3000,127.0.0.1:8080
ALLOW_LOCAL_SCANNING=false

# Rate limits (SlowAPI)
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_SCAN=3/minute
RATE_LIMIT_PDF=5/minute
